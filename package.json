{
  "name": "express-starter",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --env-file=.env.local.development run --watch ./src/index.ts",
    "start": "bun --env-file=.env dist/index.js",
    "build": "bun --env-file=.env build ./src/index.ts --outdir dist --target bun",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run ./src/scripts/seed.ts",
    "test": "cross-env APP_STAGE=test vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@libsql/client": "^0.15.15",
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/supertest": "^6.0.3"
  },
  "peerDependencies": {
    "typescript": "^5",
    "@types/express": "^5.0.5",
    "@types/ip": "^1.1.3",
    "@types/node": "^24.8.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.1.0",
    "ip": "^2.0.1",
    "jose": "^6.1.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "uuid": "^14.0.0",
    "vitest": "^4.0.16",
    "zod": "^4.1.12"
  }
}
